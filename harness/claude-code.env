# FREECC — Claude Code wiring (evidence E14, E15)
# Source this file (or let harness/run-claude-code.sh do it), then run `claude`.
# Requires: router/start.sh running on :4000, router/.env filled.

# --- point Claude Code at the FREECC router instead of api.anthropic.com ------
export ANTHROPIC_BASE_URL="http://localhost:4000"
export ANTHROPIC_AUTH_TOKEN="${LITELLM_MASTER_KEY:-sk-freecc-change-me}"

# --- remap the pinned aliases mikoshi-construct's agents use (E4+E15) ---------
# implementer agent pins `model: sonnet`; harness/architect pin `inherit`
# (= ANTHROPIC_MODEL). haiku = OpenCode/Claude Code background+small tasks.
export ANTHROPIC_DEFAULT_OPUS_MODEL="opus"
export ANTHROPIC_DEFAULT_SONNET_MODEL="sonnet"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="haiku"
export ANTHROPIC_MODEL="sonnet"

# --- populate the /model picker from the gateway (E15) -------------------------
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# --- sanity: after `claude` starts, run /status and /model --------------------
# /model should list opus, sonnet, haiku "From gateway". Switch to `opus` for
# /plan and architecture work; stay on `sonnet` for /implement low rungs.
