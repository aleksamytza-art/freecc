# FREECC ROUTER — environment (copy to router/.env and fill)
# All keys below are FREE to obtain except DeepSeek (near-free, optional) and Ollama (local).

# --- secrets -----------------------------------------------------------------
LITELLM_MASTER_KEY=sk-freecc-change-me            # any long random string; Claude Code/OpenCode auth with it
GEMINI_API_KEY=                                   # https://aistudio.google.com/apikey  (free tier, E11)
GROQ_API_KEY=                                     # https://console.groq.com            (free tier, E12)
OPENROUTER_API_KEY=                               # https://openrouter.ai/settings/keys (free :free models, E13)
DEEPSEEK_API_KEY=                                 # https://platform.deepseek.com       (near-free, E17) — optional
OLLAMA_BASE=http://localhost:11434                # optional local fallback

# --- current free-tier model IDs (VERIFY before each deploy; quotas move — E11)
# Gemini: check https://aistudio.google.com/rate-limit for YOUR project's live limits
GEMINI_STRONG_MODEL=gemini-3-pro
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.8-flash-lite
GEMINI_STRONG_RPM=2
GEMINI_STRONG_TPM=32000
GEMINI_FAST_RPM=10
GEMINI_FAST_TPM=250000

# Groq: check https://console.groq.com/docs/rate-limits for per-model free limits
GROQ_MID_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_RPM=30
GROQ_TPM=6000
GROQ_FAST_RPM=30
GROQ_FAST_TPM=6000

# OpenRouter: browse https://openrouter.ai/models?max_price=0 for today's :free models
OPENROUTER_STRONG_MODEL=deepseek/deepseek-v3:free
OPENROUTER_CODER_MODEL=qwen/qwen3-coder:free
OPENROUTER_FREE_RPM=10

# Ollama (local, optional): ollama pull <model> first
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_SMALL_MODEL=qwen2.5-coder:1.5b

# --- budget policy -----------------------------------------------------------
FREECC_DAILY_TOKEN_BUDGET=20000000    # soft daily ceiling across all agents (see REPORT.md math)
